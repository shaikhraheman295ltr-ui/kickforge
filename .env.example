# Optional: set to your real backend API URL (e.g., https://api.kickforge.com)
# When unset, the cart uses DEMO mode and shows "DEMO MODE — NO REAL ORDER PLACED"
NEXT_PUBLIC_API_URL=

# OpenRouter API (free tier - Nex-N2.5-Pro for coding/website tasks)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
